# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pre-commit-cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.uv-cache/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

# Local environment and secrets
.env
.env.*
!.env.example

# IDE and OS files
.idea/
.vscode/
.DS_Store

# Project-generated data and artifacts
data/raw/*
data/interim/*
data/processed/*
data/external/*
artifacts/*
reports/figures/*
reports/tables/*

# Keep directory placeholders
!.gitkeep
